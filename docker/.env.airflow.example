# Copy to docker/.env.airflow (gitignored) and fill in.
# Gmail needs an App Password: https://myaccount.google.com/apppasswords
AIRFLOW__SMTP__SMTP_USER=you@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=your-16-char-app-password
AIRFLOW__SMTP__SMTP_MAIL_FROM=you@gmail.com

# Comma-separated recipients for drift/bias alerts
ALERT_EMAIL_TO=you@gmail.com
