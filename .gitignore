# ============================================================
# FILE: .gitignore
# ============================================================
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/

# Distribution
dist/
build/
*.egg-info/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local
*.env

# Data (large files)
# data/
*.h5
*.hdf5
*.npy
*.npz
# ...except the learner UI case bank, versioned through Git LFS (see .gitattributes)
!models/case_bank/*.npz

# Models
# models/
*.pt
*.pth
*.onnx

# MLflow
mlruns/

# Kubernetes secrets (never commit!)
k8s/**/secrets.yaml
!k8s/**/secrets.yaml.template

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/mlflow.db
mlflow.db

#Airflow
airflow/logs/
docker/airflow/

#Evidently
reports/

#Docker airflow configs:
docker/docker-compose.airflow.override.yml

#gcloud
google-cloud-sdk/
*.tar.gz

# k8s: real overlay kustomizations and secret env files stay local
k8s/overlays/*/*.secret.env

# Cloud credentials
gcp-key.json
*-key.json

# Docker secrets
docker/.env.airflow

# Local LLM weights (multi-GB)
*.gguf
models/llm/

# Training outputs (tracked in MLflow; promoted weights go to models/best_model.pth)
models/runs/

# Terraform: state holds generated DB passwords; never commit it
infra/terraform/**/.terraform/
infra/terraform/**/.build/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
