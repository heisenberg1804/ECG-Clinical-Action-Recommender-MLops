# ============================================================
# FILE: .env.example (place in project root, DO commit this)
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --------------------- Environment ---------------------
ENVIRONMENT=development
DEBUG=true

# --------------------- Database ---------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecg


# --------------------- MLflow ---------------------
MLFLOW_TRACKING_URI=http://localhost:5000

# --------------------- Model ---------------------
MODEL_VERSION=latest
MODEL_PATH=./models

# --------------------- Data ---------------------
PTB_XL_PATH=~/data/ptb-xl/physionet.org/files/ptb-xl/1.0.3

# --------------------- Tutor (D-56 to D-58) ---------------------
# Off unless set to true. Requires every value below.
CHAT_ENABLED=false
ANTHROPIC_API_KEY=            # from console.anthropic.com; set a monthly spend limit there
TUTOR_PASSCODE=               # given to interviewers; the case viewer stays open without it
TUTOR_SESSION_SECRET=         # signs session tokens: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Optional (defaults shown)
# TUTOR_MODEL=claude-opus-5-5
# TUTOR_EFFORT=medium
# TUTOR_MAX_TOKENS=8000
# TUTOR_MAX_TURNS=30
# TUTOR_DAILY_BUDGET_USD=3.0
